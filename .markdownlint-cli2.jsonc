{
  "config": {
    "default": false,
    "MD001": true,
    "MD003": {
      "style": "atx",
    },
    "MD042": true,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.expo/**",
  ],
  "gitignore": true,
}
