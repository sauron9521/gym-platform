{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/admin": {
      "playwright": false,
      "entry": [
        "playwright.config.ts",
        "playwright.real-api.config.ts",
        "playwright.staging.config.mjs",
        "e2e/**/*.spec.ts",
        "e2e/support/mock-api.mjs"
      ]
    },
    "apps/web": {
      "playwright": false,
      "entry": [
        "playwright.config.ts",
        "playwright.integration.config.ts",
        "e2e/specs/**/*.spec.ts",
        "e2e/integration/**/*.spec.ts",
        "e2e/support/mock-api.mjs"
      ]
    },
    "apps/api": {
      "entry": ["src/infra/openapi/export-openapi.ts", "test/support/seed-admin-browser.ts"]
    },
    "packages/api-client": {
      "entry": ["test/contract-types.test.ts"]
    }
  }
}
