{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/admin": {
      "playwright": false,
      "entry": [
        "playwright.config.ts",
        "playwright.real-api.config.ts",
        "playwright.staging.config.mjs",
        "e2e/**/*.spec.ts"
      ]
    },
    "apps/web": {
      "playwright": false,
      "entry": [
        "playwright.config.ts",
        "playwright.integration.config.ts",
        "e2e/specs/**/*.spec.ts",
        "e2e/integration/**/*.spec.ts"
      ]
    }
  }
}
