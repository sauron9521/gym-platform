{
  "name": "gym-platform",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @gym/api dev",
    "dev:web": "pnpm --filter @gym/web dev",
    "dev:landing": "pnpm --filter @gym/landing dev",
    "dev:admin": "pnpm --filter @gym/admin dev",
    "dev:trainer": "pnpm --filter @gym/trainer dev",
    "dev:mobile": "pnpm --filter @gym/mobile dev",
    "db:up": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml down",
    "db:ps": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml ps",
    "db:logs": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml logs -f --tail=100",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "api:openapi": "pnpm --filter @gym/api docs:openapi",
    "api:types": "pnpm --filter @gym/api-client generate",
    "api:contract:generate": "pnpm api:openapi && pnpm api:types && pnpm exec prettier --write apps/api/openapi/openapi.json packages/api-client/src/generated/schema.d.ts",
    "api:contract:check": "pnpm api:contract:generate && git diff --exit-code -- apps/api/openapi/openapi.json packages/api-client/src/generated/schema.d.ts",
    "perf:api:baseline": "node scripts/api-performance-baseline.mjs",
    "perf:api:compare": "node scripts/api-performance-compare.mjs",
    "perf:api:repeats": "node scripts/api-performance-repeats.mjs",
    "test:tooling": "vitest run --config vitest.config.mts",
    "knip": "knip",
    "knip:report": "knip --no-exit-code --no-progress --reporter compact",
    "turbo:plan": "turbo run lint typecheck build --dry=json",
    "architecture:cruise": "depcruise --config .dependency-cruiser.cjs --include-only \"^(apps|packages|tooling)/[^/]+/src/\" --output-type err apps packages tooling",
    "architecture:cruise:named": "node scripts/dependency-cruiser-named-imports.mjs",
    "architecture:cruise:relative": "node scripts/dependency-cruiser-relative-imports.mjs",
    "architecture:cruise:boundaries": "node scripts/dependency-cruiser-workspace-imports.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:check": "pnpm docs:lint && pnpm test:tooling scripts/documentation.test.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "18.9.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "knip": "6.48.0",
    "lint-staged": "^17.6.2",
    "markdownlint-cli2": "0.24.2",
    "mdast-util-from-markdown": "2.1.0",
    "prettier": "^3.10.0",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.18.0"
}
