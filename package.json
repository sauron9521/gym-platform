{
  "name": "gym-platform",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @gym/api dev",
    "dev:web": "pnpm --filter @gym/web dev",
    "dev:mobile": "pnpm --filter @gym/mobile dev",
    "db:up": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml down",
    "db:ps": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml ps",
    "db:logs": "docker compose --env-file infra/docker/.env -f infra/docker/compose.yaml logs -f --tail=100",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "turbo": "^2.11.11"
  },
  "packageManager": "pnpm@12.18.0"
}
