{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["GYM_API_INTERNAL_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**", ".cache/expo-ios/**"],
      "env": [
        "LANDING_SITE_URL",
        "LANDING_ALLOW_INDEXING",
        "NEXT_PUBLIC_UMAMI_WEBSITE_ID",
        "NEXT_PUBLIC_UMAMI_SCRIPT_URL"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
