# Local-only Docker Compose settings. Copy to infra/docker/.env.
# Not production credentials. Keep local ports bound to 127.0.0.1.
POSTGRES_USER=gym_local
POSTGRES_PASSWORD=gym_local_password_change_me
POSTGRES_DB=gym_app_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Optional per-process PostgreSQL pool overrides (see production reliability foundation).
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_TIMEOUT_MS=10000

NOTIFICATION_DISPATCH_ENABLED=false
