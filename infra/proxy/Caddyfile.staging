{
	default_bind 127.0.0.1
	admin off
	local_certs
	auto_https disable_redirects
	servers {
		strict_sni_host on
	}
}

# Inactive staging candidate. Local CA only; no public ACME or Cloudflare trust.
# Only direct loopback access is allowed; a live reviewed access policy is separate.
(upstream) {
	@denied not remote_ip 127.0.0.1/32
	respond @denied 403
	@private path_regexp (?i)^/(backend/)?internal(/|$)
	respond @private 404
	reverse_proxy 127.0.0.1:{args[0]} {
		header_up -Forwarded
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		header_up -X-Real-IP
		header_up -X-Forwarded-Port
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

http://staging.ovranto.com, http://app-staging.ovranto.com, http://coach-staging.ovranto.com, http://admin-staging.ovranto.com, http://api-staging.ovranto.com {
	route {
		@denied not remote_ip 127.0.0.1/32
		respond @denied 403
		redir https://{host}{uri} 308
	}
}

http:// {
	respond 421
}

staging.ovranto.com {
	route {
		import upstream 3002
	}
}

app-staging.ovranto.com {
	route {
		import upstream 3000
	}
}

coach-staging.ovranto.com {
	route {
		import upstream 3004
	}
}

admin-staging.ovranto.com {
	route {
		import upstream 3003
	}
}

api-staging.ovranto.com {
	route {
		import upstream 3001
	}
}
