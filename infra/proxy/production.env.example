# Illustrative values ONLY; no live credentials or deployment authorization.
# Copy into an ignored, private file after operator review.
OVRANTO_ACME_EMAIL=operator@example.test
APP_URL=https://app.ovranto.com
ADMIN_APP_URL=https://admin.ovranto.com
TRAINER_APP_URL=https://coach.ovranto.com
JWT_ISSUER=https://api.ovranto.com
CORS_ORIGINS=https://app.ovranto.com,https://coach.ovranto.com,https://admin.ovranto.com
# Keep empty until actual immediate peer addresses are verified.
TRUSTED_PROXY_CIDRS=
API_PORT=3001
WEB_PORT=3000
LANDING_PORT=3002
ADMIN_PORT=3003
TRAINER_PORT=3004
# Required external DATABASE_URL, REDIS_URL, JWT_SECRET, SMTP_URL, MAIL_FROM
# must be supplied privately, not copied from a live environment into CI.
NOTIFICATION_DISPATCH_ENABLED=false
HTTP_METRICS_ENABLED=false
