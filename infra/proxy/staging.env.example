# Illustrative values ONLY; no live credentials or deployment authorization.
# Copy into an ignored, private file after operator review.
APP_URL=https://app-staging.ovranto.com
ADMIN_APP_URL=https://admin-staging.ovranto.com
TRAINER_APP_URL=https://coach-staging.ovranto.com
JWT_ISSUER=https://api-staging.ovranto.com
CORS_ORIGINS=https://app-staging.ovranto.com,https://coach-staging.ovranto.com,https://admin-staging.ovranto.com
# Keep empty until actual immediate peer addresses are verified.
TRUSTED_PROXY_CIDRS=
API_PORT=3001
WEB_PORT=3000
LANDING_PORT=3002
ADMIN_PORT=3003
TRAINER_PORT=3004
# Required staging-only DATABASE_URL, REDIS_URL, JWT_SECRET, SMTP_URL, MAIL_FROM
# must be supplied privately, not copied from a live environment into CI.
NOTIFICATION_DISPATCH_ENABLED=false
HTTP_METRICS_ENABLED=false
# Synthetic recipient only; replace privately after approved staging mail review.
SMTP_RECIPIENT_ALLOWLIST=fixture@example.test
