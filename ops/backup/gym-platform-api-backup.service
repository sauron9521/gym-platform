# OPT-IN. This service has DB backup credentials and Docker access: root-only.
# Install only on a trusted host after provisioning a private backup directory.
[Unit]
Description=Gym API verified daily PostgreSQL and avatar backup
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/gym-platform
EnvironmentFile=/etc/gym-platform/backup.env
ExecStart=/usr/bin/bash /opt/gym-platform/scripts/backup-production.sh /srv/private/gym-backups
ExecStartPost=/usr/bin/bash /opt/gym-platform/scripts/verify-backup-freshness.sh /srv/private/gym-backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/srv/private/gym-backups
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
TimeoutStartSec=2h
