# Install a locally adjusted copy at /etc/gym-platform/monitoring.env.
# The JSONL file is generated every minute by the separately installed
# trusted forwarder (ops/monitoring/gym-platform-api-forwarder.service). Only
# that service may use the Docker API; the monitor has read-only access.
MONITOR_LOG_FILE=/var/log/gym-platform-api/events.jsonl
# Monitoring origin as reachable from the operator host (no credentials/path).
MONITOR_API_ORIGIN=http://127.0.0.1:3001
# Existing node_exporter directory, writable by gym-monitor.
MONITOR_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/gym_api_monitor.prom
