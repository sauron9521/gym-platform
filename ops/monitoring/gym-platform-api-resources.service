# OPT-IN trusted Docker sampler, deliberately separate from unprivileged gym-monitor.
[Unit]
Description=Gym API container resource metrics (trusted Docker host collector)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=node_exporter
WorkingDirectory=/opt/gym-platform
EnvironmentFile=/etc/gym-platform/resources.env
ExecStart=/usr/bin/env node /opt/gym-platform/scripts/monitoring-docker-resources.mjs
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
TimeoutStartSec=40
