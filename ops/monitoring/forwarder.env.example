# Install manually as /etc/gym-platform/forwarder.env, root-owned mode 0600.
# The forwarder may use the Docker API; treat it as host privileged.
FORWARD_CONTAINER=gym-platform-api-api-1
# MUST match the unprivileged monitor's MONITOR_LOG_FILE.
FORWARD_LOG_FILE=/var/log/gym-platform-api/events.jsonl
