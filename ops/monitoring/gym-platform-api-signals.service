# Opt-in trusted host sampler. Docker socket is never granted to gym-monitor.
[Unit]
Description=Gym API bounded Docker events and cgroup v2 throttling sampling
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=node_exporter
WorkingDirectory=/opt/gym-platform
EnvironmentFile=/etc/gym-platform/signals.env
ExecStart=/usr/bin/env node /opt/gym-platform/scripts/monitoring-docker-signals.mjs
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
TimeoutStartSec=45
