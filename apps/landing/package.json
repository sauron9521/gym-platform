{
  "name": "@gym/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:contracts && pnpm test:components",
    "test:e2e": "playwright test",
    "test:contracts": "vitest run --config vitest.config.mts",
    "test:components": "vitest run --config vitest.components.config.mts"
  },
  "dependencies": {
    "@gym/design-tokens": "workspace:*",
    "@gym/i18n": "workspace:*",
    "@gym/ui-web": "workspace:*",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "happy-dom": "21.0.4"
  },
  "description": "Public presentation site for Gym Platform"
}
