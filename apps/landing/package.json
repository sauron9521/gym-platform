{
  "name": "@gym/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "pnpm test && next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:contracts && pnpm test:components",
    "test:e2e": "playwright test",
    "test:contracts": "vitest run --config vitest.config.mts",
    "test:components": "vitest run --config vitest.components.config.mts"
  },
  "dependencies": {
    "@gym/design-tokens": "workspace:*",
    "@gym/ui-web": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "react-hook-form": "7.92.0",
    "@hookform/resolvers": "7.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.4.47",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "happy-dom": "21.0.4"
  },
  "description": "Public presentation site for Gym Platform"
}
