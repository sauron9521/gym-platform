{
  "name": "@gym/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "node scripts/export-web.mjs && node scripts/export-ios.mjs",
    "build:ios": "node scripts/export-ios.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:contracts && pnpm test:unit",
    "doctor": "expo-doctor",
    "test:contracts": "vitest run --config vitest.contracts.config.mts",
    "test:unit": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@gym/api-client": "workspace:*",
    "@gym/design-tokens": "workspace:*",
    "@gym/domain": "workspace:*",
    "@gym/i18n": "workspace:*",
    "@hookform/resolvers": "7.0.8",
    "@tanstack/react-query": "5.107.1",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-intl": "12.1.7",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "uniwind": "^1.13.2",
    "zod": "4.6.7",
    "@react-native-async-storage/async-storage": "2.2.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.17.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-native": "0.15.1"
  }
}
