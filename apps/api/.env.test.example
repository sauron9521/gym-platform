NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym_app_test?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym_app_test?schema=public
JWT_SECRET=only-for-testing-change-this-in-production
JWT_ISSUER=http://localhost:3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PORT=3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
ENABLE_OPENAPI=false
SMTP_URL=
MAIL_FROM=Gym Test <no-reply@example.test>

# Optional: enables the dedicated real-Redis rate-limit integration tests.
TEST_REDIS_URL=
# Keep REDIS_URL empty for ordinary application integration tests.
REDIS_URL=
TRUSTED_PROXY_CIDRS=
