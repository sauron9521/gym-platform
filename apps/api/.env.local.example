# Local development only. Copy to apps/api/.env.
# Keep the PostgreSQL username/password/port synchronized with infra/docker/.env.
NODE_ENV=development
DATABASE_URL=postgresql://gym_local:gym_local_password_change_me@127.0.0.1:5432/gym_app_dev?schema=public
# Only used by tests; never pass this to the running development API.
TEST_DATABASE_URL=postgresql://gym_local:gym_local_password_change_me@127.0.0.1:5432/gym_app_test?schema=public
JWT_SECRET=local-dev-only-use-a-different-random-secret-in-production
JWT_ISSUER=http://localhost:3001
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PORT=3001
LOG_LEVEL=log
ENABLE_OPENAPI=false
REDIS_URL=redis://127.0.0.1:6379
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Gym Dev <dev@example.test>
TRUSTED_PROXY_CIDRS=
