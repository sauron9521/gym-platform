{
  "name": "@gym/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.json",
    "docs:openapi": "nest build && node dist/infra/openapi/export-openapi.js",
    "architecture:check": "node scripts/check-architecture.mjs",
    "architecture:deps": "node scripts/check-feature-dependencies.mjs",
    "test:architecture": "vitest run --config ./vitest.config.tools.ts scripts/check-architecture.test.mjs scripts/check-feature-dependencies.test.mjs scripts/import-parser.test.mjs",
    "test:coverage-tools": "vitest run --config ./vitest.config.tools.ts scripts/coverage-report.test.mjs scripts/coverage-inventory.test.mjs",
    "coverage:summary": "node scripts/coverage-report.mjs",
    "coverage:inventory": "node scripts/coverage-inventory.mjs",
    "db:baseline:check": "node scripts/verify-prisma-baseline.mjs",
    "test:contracts": "vitest run --config ./vitest.config.tools.ts test/migration-baseline.test.mjs test/production-docker.test.mjs"
  },
  "dependencies": {
    "@gym/datetime": "workspace:*",
    "@gym/domain": "workspace:*",
    "@nestjs/authentication": "^0.1.7",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/mail": "^0.0.2",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.9",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#prisma/*": {
      "types": "./src/infra/database/generated/prisma/*.ts",
      "default": "./dist/infra/database/generated/prisma/*.js"
    }
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
