enum Role {
  ATHLETE
  TRAINER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String    @id @default(uuid(4))
  email         String    @unique()
  emailVerified Boolean   @default(false) @map("email_verified")
  passwordHash  String    @map("password_hash")
  role          Role      @default(ATHLETE)
  status        AccountStatus @default(ACTIVE)
  authInvalidatedAt DateTime? @map("auth_invalidated_at") @db.Timestamptz(3)
  preferredLocale String?  @map("preferred_locale") @db.VarChar(10)
  autoRestTimer Boolean? @map("auto_rest_timer")
  restDurationSeconds Int? @map("rest_duration_seconds")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt() @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  // Relation
  notificationSettings NotificationSettings?
  notificationPreferences NotificationPreference[]
  profile                    Profile?
  trainerProfile             TrainerProfile?
  trainerApplications        TrainerApplication[] @relation("TrainerApplicationApplicant")
  reviewedTrainerApplications TrainerApplication[] @relation("TrainerApplicationReviewer")
  revokedTrainerApplications TrainerApplication[] @relation("TrainerApplicationRevoker")
  approvedTrainerProfiles    TrainerProfile[] @relation("TrainerProfileApprover")
  revokedTrainerProfiles     TrainerProfile[] @relation("TrainerProfileRevoker")
  bodyMeasurements     BodyMeasurement[]
  sessions             Session[]
  refreshTokens        RefreshToken[]
  refreshTokenFamilies RefreshTokenFamily[]
  emailTokens          EmailToken[]
  accountDeletionRequest AccountDeletionRequest?
  mfaAuthenticator MfaAuthenticator?
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaFailures MfaFailure[]

  // Exercises
  createdExercises            Exercise[]                  @relation("ExerciseCreator")
  exerciseTrainerAccess       ExerciseTrainerAccess[]     @relation("ExerciseAccessTrainer")
  receivedExerciseAssignments ExerciseAthleteAssignment[] @relation("ExerciseAssignedAthlete")
  createdExerciseAssignments  ExerciseAthleteAssignment[] @relation("ExerciseAssignedBy")

  // Workouts
  athleteWorkouts Workout[] @relation("WorkoutAthlete")
  createdWorkouts Workout[] @relation("WorkoutCreator")

  // Trainer - Athlete relationships
  trainerRelationships             TrainerAthlete[] @relation("TrainerAthleteTrainer")
  athleteRelationships             TrainerAthlete[] @relation("TrainerAthleteAthlete")
  initiatedTrainerAthleteRequests  TrainerAthlete[] @relation("TrainerAthleteInitiator")
  endedTrainerAthleteRelationships TrainerAthlete[] @relation("TrainerAthleteEndedBy")

  // Training Programs
  createdTrainingPrograms TrainingProgram[] @relation("TrainingProgramTrainer")

  receivedProgramAssignments TrainingProgramAssignment[] @relation("ProgramAssignmentAthlete")
  createdProgramAssignments  TrainingProgramAssignment[] @relation("ProgramAssignmentAssignedBy")
  endedProgramAssignments    TrainingProgramAssignment[] @relation("ProgramAssignmentEndedBy")

  @@map("users")
}

model AccountDeletionRequest {
  id          String   @id @default(uuid(4))
  userId      String   @unique @map("user_id")
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_deletion_requests")
}
