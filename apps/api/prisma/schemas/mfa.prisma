// Identity-scoped MFA persistence. The authentication library seals TOTP secrets
// and hashes recovery codes before they reach this adapter.
model MfaAuthenticator {
  userId String @id @map("user_id")
  secret String @db.Text
  confirmed Boolean @default(false)
  pendingSecret String? @map("pending_secret") @db.Text
  lastUsedStep Int? @map("last_used_step")
  // Enrollment or replacement is a short-lived challenge bound to one Admin session.
  enrollmentSessionId String? @map("enrollment_session_id") @db.VarChar(64)
  enrollmentExpiresAt DateTime? @map("enrollment_expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_authenticators")
}

model MfaRecoveryCode {
  userId String @map("user_id")
  hash String @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, hash])
  @@map("mfa_recovery_codes")
}

model MfaFailure {
  id String @id @default(uuid(4))
  userId String @map("user_id")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("mfa_failures")
}

// Append-only lifecycle evidence, retained independently from account deletion.
enum MfaLifecycleAction {
  FIRST_TOTP_CONFIRMED
  ADMIN_TOTP_CHALLENGE_VERIFIED
  ADMIN_RECOVERY_CHALLENGE_VERIFIED
  ADMIN_RECOVERY_CODES_REGENERATED
  ADMIN_TOTP_REPLACEMENT_STAGED
  ADMIN_TOTP_REPLACEMENT_CONFIRMED
}

model MfaLifecycleAudit {
  id String @id @default(uuid(4))
  userId String @map("user_id")
  action MfaLifecycleAction
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([userId, occurredAt(sort: Desc)])
  @@map("mfa_lifecycle_audit")
}
