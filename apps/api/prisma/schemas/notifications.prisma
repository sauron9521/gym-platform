// Shared notification outbox, ADR-008 / #568. No dispatcher is enabled yet.
enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  DEAD_LETTER
}

model OutboxEvent {
  id String @id @default(uuid(4))
  eventKey String @unique @map("event_key") @db.VarChar(200)
  type String @db.VarChar(100)
  schemaVersion Int @map("schema_version")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  actorUserId String? @map("actor_user_id")
  payload Json
  status OutboxEventStatus @default(PENDING)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  attemptCount Int @default(0) @map("attempt_count")
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  lastErrorCode String? @map("last_error_code") @db.VarChar(100)

  @@index([status, availableAt])
  @@index([status, leaseUntil])
  @@index([actorUserId])
  @@map("outbox_events")
}

// External-channel preferences only. Inbox and urgent auth mail are independent.
enum NotificationCategory {
  TRAINER
  PROGRAM
  WORKOUT
  ACCOUNT
}

enum NotificationChannel {
  MOBILE_PUSH
  LOCAL_REMINDER
  EMAIL
}

model NotificationSettings {
  userId String @id @map("user_id")
  quietHoursEnabled Boolean @default(true) @map("quiet_hours_enabled")
  quietStartMinute Int @default(1320) @map("quiet_start_minute")
  quietEndMinute Int @default(480) @map("quiet_end_minute")
  reminderLeadMinutes Int @default(60) @map("reminder_lead_minutes")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model NotificationPreference {
  userId String @map("user_id")
  category NotificationCategory
  channel NotificationChannel
  enabled Boolean @default(false)
  consentedAt DateTime? @map("consented_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
  @@map("notification_preferences")
}
