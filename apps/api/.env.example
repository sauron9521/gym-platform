# Default is development; explicitly set production in deployment.
NODE_ENV=development

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
# Per API process (budget separately for dedicated lock clients and migrations).
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# Test database only, not required by the running application:
TEST_DATABASE_URL=

JWT_SECRET=
# Reserved for the gated MFA rollout; leave empty until enrollment and recovery are ready.
# API-only secret: 1–5 comma-separated random 32-byte base64url keys, newest first.
MFA_ENCRYPTION_KEYS=
JWT_ISSUER=http://localhost:3001
APP_URL=http://localhost:3000
# Optional exact Admin origin (HTTPS in production) for cookie sessions and CSRF.
ADMIN_APP_URL=
# Trainer Web (localhost:3004); set exact origin to allow host-only browser sessions.
# Required for Trainer sign-in; HTTPS required in production.
TRAINER_APP_URL=http://localhost:3004
# Expo Web typically serves at http://localhost:8081. Add its exact origin here and
# keep CORS and CSRF origin allowlists aligned; never use wildcard origins.
# If Expo Web uses a LAN host, list that origin explicitly too.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3004,http://localhost:8081
PORT=3001
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
ENABLE_OPENAPI=false

# Optional in development/test; required in production (smtps://).
SMTP_URL=
# Required in production. Use your verified sender domain.
MAIL_FROM=Gym Dev <dev@example.test>

# Optional persistent directory (default ./uploads/avatars).
AVATAR_STORAGE_DIR=

# Optional Redis-backed rate limit state for multi-replica deployments.
# If omitted, the throttler remains process-local (single-instance only).
# Use rediss:// for TLS when Redis is not on an isolated private network.
REDIS_URL=
# IP addresses / CIDR ranges of trusted reverse proxies, CSV.
# Leave blank when the API is directly exposed. Never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
# Optional, operator-managed SUPERADMIN elevation: comma-separated ADMIN user UUIDs.
# Empty = no elevated grants. Never put this in a browser-visible environment.
SUPERADMIN_USER_IDS=

# Opt-in only after notification dispatcher readiness checks.
NOTIFICATION_DISPATCH_ENABLED=false
