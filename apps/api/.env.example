# Default is development; explicitly set production in deployment.
NODE_ENV=development

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
# Test database only, not required by the running application:
TEST_DATABASE_URL=

JWT_SECRET=
JWT_ISSUER=http://localhost:3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=3000
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
ENABLE_OPENAPI=false

# Optional in development/test; required in production (smtps://).
SMTP_URL=
# Required in production. Use your verified sender domain.
MAIL_FROM=Gym Dev <dev@example.test>

# Optional persistent directory (default ./uploads/avatars).
AVATAR_STORAGE_DIR=

# Optional Redis-backed rate limit state for multi-replica deployments.
# If omitted, the throttler remains process-local (single-instance only).
# Use rediss:// for TLS when Redis is not on an isolated private network.
REDIS_URL=
# IP addresses / CIDR ranges of trusted reverse proxies, CSV.
# Leave blank when the API is directly exposed. Never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
